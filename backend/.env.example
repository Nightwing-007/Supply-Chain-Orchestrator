# ── PostgreSQL Connection ──────────────────────────────────────
DATABASE_URL=postgresql://postgres:password123@localhost:5432/supply_chain

# ── Priority 1: Groq API (Primary LLM - Llama-3.3-70B) ────────
GROQ_API_KEY=your_groq_api_key_here

# ── Priority 2: GitHub Models (Secondary LLM - GPT-4o-mini) ───
GITHUB_TOKEN=your_github_token_here

# ── Priority 3: Google Gemini API (Tertiary LLM - Gemini 2.0) ─
GOOGLE_API_KEY=your_gemini_api_key_here

# ── Application Settings ───────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development
