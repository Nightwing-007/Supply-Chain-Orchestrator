.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ── Testing & Coverage ──
.pytest_cache/
.coverage
htmlcov/
.nox/
.tox/

# ── Database & Log files ──
*.log
*.sqlite3
*.db

# ── Frontend ──
ui/node_modules/
ui/dist/
ui/out.css
